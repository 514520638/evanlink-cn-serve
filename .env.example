# 管理员与数据库配置必须从环境提供，无默认账号密码。
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/evanlink_cn?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Java 后端从当前工作目录的 .env 读取；不要给值加引号。
# 使用已重置的应用凭据，不要填写到前端或 Python Agent。
# CLIENT_ID 必须填 AppKey（字母数字串），不能填纯数字 AppID。
BAIDU_NETDISK_CLIENT_ID=
BAIDU_NETDISK_CLIENT_SECRET=
BAIDU_NETDISK_REDIRECT_URI=https://evanlink.cn/api/album/baidu/callback
# 使用 openssl rand -base64 32 生成，妥善备份，变更后旧授权将无法解密。
BAIDU_NETDISK_TOKEN_KEY=
BAIDU_NETDISK_ROOT=/evan-blog-album
